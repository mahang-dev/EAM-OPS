# Copy to .env; replace every CHANGE_ME value before starting.
DB_URL=jdbc:mysql://127.0.0.1:3306/eam_ops?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai
DB_USER=eam
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
# production does not create demo accounts. Set demo explicitly for sample data.
SPRING_PROFILES_ACTIVE=production
WEB_PORT=8088
